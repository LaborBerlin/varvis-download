{
  "name": "varvis-download",
  "version": "0.33.1",
  "type": "module",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/LaborBerlin/varvis-download.git"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.0.0"
  },
  "main": "varvis-download.cjs",
  "scripts": {
    "test": "jest",
    "test:integration": "jest --config=jest.integration.config.cjs --runInBand",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "architecture:check": "node scripts/check-architecture-budget.mjs",
    "check": "npm run lint && npx prettier --check . && npm run type-check && npm test && npm run architecture:check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:generate": "node docs/scripts/docs-generator.cjs",
    "docs:api": "npm run docs:generate && npm run docs:build",
    "prepare": "husky",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "keywords": [
    "api",
    "cli",
    "data-download",
    "varvis",
    "node",
    "bioinformatics",
    "genomics",
    "authentication",
    "proxy-support"
  ],
  "author": "Bernt Popp",
  "license": "GPL-3.0",
  "dependencies": {
    "date-fns": "^4.4.0",
    "fs-extra": "^11.3.6",
    "http-cookie-agent": "^8.0.0",
    "mute-stream": "^4.0.0",
    "progress": "^2.0.3",
    "tough-cookie": "^6.0.2",
    "undici": "^8.7.0",
    "winston": "^3.19.0",
    "yargs": "^18.0.0"
  },
  "bin": {
    "varvis-download": "./varvis-download.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.2.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unicorn": "^72.0.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jsdoc": "^4.0.5",
    "jsdoc-to-markdown": "^9.1.3",
    "lint-staged": "^17.1.0",
    "nock": "^14.0.17",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  },
  "lint-staged": {
    "*.{js,cjs}": "eslint --fix"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "js-yaml": "^3.15.0",
    "markdown-it": "^14.2.0",
    "vite": "^6.4.3"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2
  }
}
